# AI assistant configuration. Copy to backend/.env and fill in a key.
#
# The assistant is offered in the UI only for providers whose key is set (Gemini on
# Vertex AI: VERTEX_PROJECT or VERTEX_API_KEY); with none the app runs exactly as
# before and the chat button is hidden.
# backend/.env is gitignored — never commit real keys.

ANTHROPIC_API_KEY=
# The Gemini Developer API key: used only when GEMINI_BACKEND=developer (also when it is unset).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Gemini backend (README, "Gemini on Vertex AI"): vertex = Vertex AI billed to VERTEX_PROJECT;
# developer (also when unset) = the Developer API with GEMINI_API_KEY.
GEMINI_BACKEND=vertex
VERTEX_PROJECT=coastal-stream-511521-j3
# Flex PayGo needs global.
VERTEX_LOCATION=global
# Empty: Application Default Credentials; set: this Vertex API key instead (VERTEX_PROJECT unused).
VERTEX_API_KEY=
# ADC on a server: GOOGLE_APPLICATION_CREDENTIALS=<service-account key file, kept outside the repo>

# Assistant model defaults — optional, the same four variables in every AEI Labs app.
# ASSISTANT_DEFAULT_PROVIDER: the provider the assistant starts on (anthropic, gemini or
# openai), used only when that provider has a key; unset: the first keyed of anthropic,
# gemini, openai. ANTHROPIC_MODEL / GEMINI_MODEL / OPENAI_MODEL: that provider's default
# model, honoured only when it is one of the provider's models in the assistant's model
# table; any other value is ignored with a warning in the log.
#ASSISTANT_DEFAULT_PROVIDER=anthropic
#ANTHROPIC_MODEL=claude-sonnet-5-5
#GEMINI_MODEL=gemini-3.8-flash
#OPENAI_MODEL=gpt-6-luna

# Tool round-trips per user turn before the loop stops.
# ASSISTANT_MAX_ITERATIONS=30
# Wall-clock cap on one python_exec call, seconds.
# ASSISTANT_EXEC_TIMEOUT=180
# Per-file cap on assistant uploads, megabytes.
# ASSISTANT_UPLOAD_MAX_MB=100
# Serve the tool registry over MCP at /mcp for external clients (Claude Code etc).
# ASSISTANT_MCP_ENABLED=1

# Several users (behind Caddy and the Google sign-in; the same AEI_* names on every AEI Labs
# platform). Leave AEI_AUTH_HEADER empty for single-user mode, as the local fleet runs:
# nothing is checked and everything belongs to AEI_LOCAL_USER.
# AEI_AUTH_HEADER=X-Auth-Request-Email
# sha256 (lowercase hex) of the X-AEI-Edge secret Caddy adds to every request it forwards.
# AEI_EDGE_SECRET_SHA256=
# sha256 (lowercase hex) of the service token AGUI sends on its internal calls (/mcp, file
# pushes, artifact downloads) as "Authorization: Bearer <token>" (one token for the fleet,
# from openssl rand -hex 32; only its digest goes here). Required with AEI_AUTH_HEADER, like
# the edge digest: the app refuses to start without either. /mcp then answers 401 without the
# token, and AGUI's X-AEI-User (the chat's owner) counts only on a call that carries it.
# AEI_SERVICE_TOKEN_SHA256=
# AEI_ADMIN_EMAILS=
# Hosts load_from_url may download from in multi-user mode (comma-separated; empty: none).
# ASSISTANT_URL_ALLOW=
